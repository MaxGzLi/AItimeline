AITIMELINE_MODEL_BASE_URL=https://api.openai.com/v1
AITIMELINE_MODEL_NAME=
AITIMELINE_MODEL_API_KEY=
# Optional model output budget. Defaults to 8192 when unset or invalid.
AITIMELINE_MODEL_MAX_TOKENS=8192
# Optional deep-read article model override. Leave blank to fall back to AITIMELINE_MODEL_*.
AITIMELINE_MODEL_DEEPREAD_BASE_URL=
AITIMELINE_MODEL_DEEPREAD_NAME=
AITIMELINE_MODEL_DEEPREAD_API_KEY=
AITIMELINE_MODEL_DEEPREAD_MAX_TOKENS=
# Whole-article token budget for deep-read generation (chapter truncation). Default 100000, clamped to 50000-150000.
AITIMELINE_DEEPREAD_ARTICLE_TOKEN_BUDGET=
# Model content language gate for generated cards: zh (default in API) or none.
AITIMELINE_CONTENT_LANGUAGE=zh
# Source discovery (optional). Without a key, discovery stays disabled and the app runs network-free.
AITIMELINE_SEARCH_PROVIDER=tavily
AITIMELINE_SEARCH_API_KEY=
# API bind address. Defaults to 127.0.0.1 (loopback only). Set to 0.0.0.0 to let
# a phone on the same Wi-Fi reach the local API (apps/mobile). Security note:
# this exposes the API — with no auth and no SSRF guard — to everyone on the
# network, so use it on trusted LANs only.
AITIMELINE_HOST=127.0.0.1
