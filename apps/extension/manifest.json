{
  "manifest_version": 3,
  "name": "AITimeline Clipper",
  "version": "0.1.0",
  "description": "Save posts from X into your local AITimeline as grounded sources.",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["lib/injectCore.js", "inject.js"],
      "css": ["inject.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": ["http://127.0.0.1:8787/*", "http://127.0.0.1:8788/*"]
}
