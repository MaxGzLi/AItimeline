diff --git a/SuperIsland/App/AppState.swift b/SuperIsland/App/AppState.swift
index d4f6b38..553b4dc 100644
--- a/SuperIsland/App/AppState.swift
+++ b/SuperIsland/App/AppState.swift
@@ -766,7 +766,11 @@ final class AppState: ObservableObject {
                 self.cancelFullExpandedDismiss()
                 self.previousModule = self.activeModule
                 self.activeModule = module
-                self.fullyExpand()
+                // Hovering opens the small bar, not the full panel. Reaching for the menu
+                // bar brushes the notch constantly; dropping a half-screen panel on every
+                // brush reads as the island firing off by itself. A tap promotes it
+                // (see IslandContainerView.handleSurfaceTap).
+                self.expand()
                 return
             }
 
@@ -1089,7 +1093,7 @@ final class AppState: ObservableObject {
         case .expanded:
             return Constants.expandedSize
         case .fullExpanded:
-            let base = Constants.fullExpandedSize
+            let base = declaredFullExpandedSize ?? Constants.fullExpandedSize
             // On non-notch Macs the toolbar is inline (no shoulder area),
             // so it eats into content height. Add space for it.
             if usesOutwardTopCorners && !presentationHasNotch {
@@ -1099,6 +1103,31 @@ final class AppState: ObservableObject {
         }
     }
 
+    /// A panel size the active extension asked for in its manifest, clamped so it can
+    /// never grow past the screen. Extensions rendering long-form content (articles,
+    /// transcripts, logs) can't say what they need otherwise — the default 658x180 is
+    /// about five lines of body text. Extensions that declare nothing get the default.
+    private var declaredFullExpandedSize: CGSize? {
+        guard case .extension_(let extensionID) = activeModule,
+              let capabilities = ExtensionManager.shared.installed.first(where: { $0.id == extensionID })?.capabilities,
+              let width = capabilities.fullExpandedWidth,
+              let height = capabilities.fullExpandedHeight
+        else { return nil }
+
+        // The window adds gutters and shadow padding on top of this (see windowSize(for:)),
+        // so leave room for them rather than letting the island run off the display.
+        let screen = presentationScreenFrame != .zero
+            ? presentationScreenFrame.size
+            : (NSScreen.main?.frame.size ?? CGSize(width: 1440, height: 900))
+        let maxWidth = screen.width - (Constants.moduleCyclerGutterWidth * 2) - 40
+        let maxHeight = screen.height - Constants.expandedShadowBottomPadding - 40
+
+        return CGSize(
+            width: min(max(width, Constants.fullExpandedSize.width), maxWidth),
+            height: min(max(height, Constants.fullExpandedSize.height), maxHeight)
+        )
+    }
+
     var windowSize: CGSize {
         windowSize(for: currentState)
     }
