{
  "name": "aitimeline",
  "version": "0.1.0",
  "private": true,
  "description": "Open-core AI knowledge timeline with a commercial hosted app experience.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @aitimeline/web",
    "dev:api": "npm run dev -w @aitimeline/api",
    "prebuild": "npm run build -w @aitimeline/core",
    "build": "npm run build --workspaces --if-present",
    "pretypecheck": "npm run build -w @aitimeline/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke:core": "npm run build -w @aitimeline/core && node scripts/smoke-core.mjs",
    "smoke:api": "npm run build -w @aitimeline/core && node scripts/smoke-api.mjs",
    "smoke:model": "npm run build -w @aitimeline/core && node scripts/smoke-model.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "smoke:agent": "npm run build -w @aitimeline/core && node scripts/smoke-agent.mjs",
    "test:unit": "vitest run",
    "test": "npm run build -w @aitimeline/core && vitest run && node scripts/smoke-core.mjs && node scripts/smoke-api.mjs && node scripts/smoke-model.mjs && node scripts/smoke-mcp.mjs && node scripts/smoke-agent.mjs"
  },
  "devDependencies": {
    "typescript": "latest",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6"
  },
  "engines": {
    "node": ">=20"
  }
}
